# GitHub Pages Frontend Configuration
# Tokens are configured in-browser via the collapsible "Studio Keys & Config" bar
# and stored strictly in localStorage (never committed to source code).
# Optional local development defaults:
VITE_GITHUB_TOKEN=
VITE_REPO_OWNER=razabharattv-lang
VITE_REPO_NAME=funzoo-tracker
VITE_GITHUB_BRANCH=main
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# GitHub Actions Repository Secrets (configure in GitHub -> Settings -> Secrets and variables -> Actions)
# GEMINI_API_KEY=
